{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Skill|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/router/pre_tool_use.py",
            "timeout": 35
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/router/post_tool_use.py",
            "timeout": 35
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/router/user_prompt_submit.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/router/pre_compact.py",
            "timeout": 25
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/router/session_start.py",
            "timeout": 35
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/router/stop.py",
            "timeout": 25
          }
        ]
      }
    ]
  }
}
